# Public Supabase access for read-only student features.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase key used by Vercel API routes for admin ingestion and AI context loading.
# Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin dashboard gate. Set this in Vercel before using /api/admin/* routes.
ADMIN_ACCESS_KEY=choose-a-long-random-admin-password

# Optional deployment-level NVIDIA overrides. You can also enter these in the Admin Dashboard.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
